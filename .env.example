# Gemini API Key 템플릿
# 본 파일을 복사하여 .env 로 이름을 변경하거나 .env 에 키를 입력하세요.
GEMINI_API_KEY=your_gemini_api_key_here

# 실시간 회의: 아래 두 값은 Netlify 환경 변수(Functions)에 등록하세요.
# 이 파일은 템플릿입니다. 실제 비밀키를 여기에 넣거나 Git에 커밋하지 마세요.
# ABLY_API_KEY: Ably 앱의 API Key 전체 값. 서버에만 보관합니다.
ABLY_API_KEY=your_ably_api_key_here
# MEETING_ADMIN_KEY: 대시보드 관리자 연결에 사용할 임의의 24자 이상 문자열.
MEETING_ADMIN_KEY=replace_with_a_random_admin_key_of_at_least_24_characters

